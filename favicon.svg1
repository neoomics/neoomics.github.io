<svg width="64" height="64" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="dnaGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#3B82F6;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#06B6D4;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#10B981;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- DNA Double Helix Structure -->
  <!-- Left Strand -->
  <path d="M16 8 Q24 16 16 24 Q8 32 16 40 Q24 48 16 56" 
        stroke="url(#dnaGradient)" stroke-width="3" fill="none" stroke-linecap="round"/>
  
  <!-- Right Strand -->
  <path d="M48 8 Q40 16 48 24 Q56 32 48 40 Q40 48 48 56" 
        stroke="url(#dnaGradient)" stroke-width="3" fill="none" stroke-linecap="round"/>
  
  <!-- Base Pairs (Horizontal Connections) -->
  <line x1="16" y1="12" x2="48" y2="12" stroke="url(#dnaGradient)" stroke-width="2" opacity="0.8"/>
  <line x1="20" y1="20" x2="44" y2="20" stroke="url(#dnaGradient)" stroke-width="2" opacity="0.8"/>
  <line x1="16" y1="28" x2="48" y2="28" stroke="url(#dnaGradient)" stroke-width="2" opacity="0.8"/>
  <line x1="20" y1="36" x2="44" y2="36" stroke="url(#dnaGradient)" stroke-width="2" opacity="0.8"/>
  <line x1="16" y1="44" x2="48" y2="44" stroke="url(#dnaGradient)" stroke-width="2" opacity="0.8"/>
  <line x1="20" y1="52" x2="44" y2="52" stroke="url(#dnaGradient)" stroke-width="2" opacity="0.8"/>
  
  <!-- Nucleotide Bases (Small Circles) -->
  <circle cx="16" cy="12" r="2" fill="url(#dnaGradient)"/>
  <circle cx="48" cy="12" r="2" fill="url(#dnaGradient)"/>
  <circle cx="20" cy="20" r="2" fill="url(#dnaGradient)"/>
  <circle cx="44" cy="20" r="2" fill="url(#dnaGradient)"/>
  <circle cx="16" cy="28" r="2" fill="url(#dnaGradient)"/>
  <circle cx="48" cy="28" r="2" fill="url(#dnaGradient)"/>
  <circle cx="20" cy="36" r="2" fill="url(#dnaGradient)"/>
  <circle cx="44" cy="36" r="2" fill="url(#dnaGradient)"/>
  <circle cx="16" cy="44" r="2" fill="url(#dnaGradient)"/>
  <circle cx="48" cy="44" r="2" fill="url(#dnaGradient)"/>
  <circle cx="20" cy="52" r="2" fill="url(#dnaGradient)"/>
  <circle cx="44" cy="52" r="2" fill="url(#dnaGradient)"/>
</svg>
